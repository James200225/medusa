# PostgreSQL and Redis must be reachable from the backend/worker containers.
DATABASE_URL=postgres://medusa:replace-me@postgres.example.com:5432/medusa?sslmode=require
REDIS_URL=rediss://default:replace-me@redis.example.com:6379

# Use long, random values; do not commit the populated .env.production file.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret

# Comma-separated browser origins; include the storefront and Admin URLs.
STORE_CORS=https://store.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://store.example.com,https://api.example.com

# Durable S3-compatible object storage for uploaded files.
S3_BUCKET=medusa-uploads
S3_REGION=us-east-1
S3_FILE_URL=https://medusa-uploads.s3.us-east-1.amazonaws.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Optional for S3-compatible services such as MinIO or R2.
# S3_ENDPOINT=https://storage.example.com

# Optional quick-dispatch hub alert webhook.
# QUICK_DISPATCH_WEBHOOK_URL=https://dispatch.example.com/medusa-events
# QUICK_DISPATCH_WEBHOOK_SECRET=replace-with-a-random-signing-secret
